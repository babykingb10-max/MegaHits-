# ── Live Sports ─────────────────────────────────────────
API_FOOTBALL_KEY=
SPORTSDB_API_KEY=

# ── Live Weather ────────────────────────────────────────
OPENWEATHER_API_KEY=

# ── Finance & Crypto ────────────────────────────────────
COINGECKO_API_KEY=
EXCHANGERATE_API_KEY=

# ── Recipes ─────────────────────────────────────────────
